@model System.Collections.Generic.IEnumerable<MyWebApplication.Models.Product>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Product List</h2>
        </div>
        <div class="col-6 text-end">
            <a  asp-action="Upsert" class="btn btn-primary">
                Create New Product
            </a>
        </div>
    </div>
    
    <br /> <br />
    
    @if (Model.Count() > 0)
    {
        <table class="table table-bordered table-striped" style="width: 100%">
            <thead>
            <tr>
                <th>
                    Product Name
                </th>
                <th>
                    Display Order
                </th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var product in @Model)
            {
                <tr>
                    <td width = "50%">@product.Name</td>
                    <td width="30%">@product.Price</td>
                    <td class="text-center">
                        <div class="w-75 btn-group" role="group">
                            <a asp-route-Id="@product.Id" asp-action="Upsert" class="btn btn-primary mx-2">
                                Edit
                            </a>
                            <a asp-route-Id="@product.Id" asp-action="Delete" class="btn btn-danger mx-2">
                                Delete
                            </a>
                        </div>
                    </td>
                </tr>
               
            }
            </tbody>
        </table>
    }
    else
    {
        <p>No products exists.</p>
    }
    
</div>
